# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="PulseSync Health Monitoring Platform"
API_V1_STR="/api/v1"
SECRET_KEY=pulsesync_super_secret_jwt_key_development_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pulsesync
POSTGRES_PASSWORD=pulsesync_secure_password
POSTGRES_DB=pulsesync_db

# Redis & Celery Background Tasks
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
